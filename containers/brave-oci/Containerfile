# The launcher copies the brew-verified brave-browser .deb from the
# Caskroom into the build context before building.
FROM docker.io/library/archlinux:latest

ARG APP_VERSION
LABEL org.opencontainers.image.title="Brave" \
      org.opencontainers.image.version="${APP_VERSION}"

COPY cask.deb /tmp/cask.deb
# Same runtime deps as the AUR brave-bin package. The deb is a plain
# archive of /opt/brave.com/brave plus desktop and icon files; unpack it
# instead of installing, since there is no apt here.
RUN pacman -Syu --noconfirm \
    && pacman -S --noconfirm --needed \
       alsa-lib gtk3 libcups libxss libxtst nss xdg-utils \
       ttf-dejavu ttf-liberation mesa libva libpulse libxkbcommon pipewire \
    && bsdtar -xOf /tmp/cask.deb data.tar.xz | bsdtar -xf - -C / \
    && rm /tmp/cask.deb \
    && pacman -Scc --noconfirm

# The container is the sandbox; Chromium's own sandbox cannot nest inside
# a rootless userns, hence --no-sandbox (set in the entrypoint).
COPY entrypoint.sh /usr/local/bin/brave-entrypoint
ENTRYPOINT ["/usr/local/bin/brave-entrypoint"]
